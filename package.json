{
    "name": "wuwa-afyg-tool",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-mdi-icons.mjs",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "download-icons": "node scripts/download-static-icons.mjs",
        "generate-icons": "node scripts/generate-icons.mjs",
        "collect-icons": "node scripts/collect-mdi-icons.mjs"
    },
    "devDependencies": {
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/svelte": "^5.2.2",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/adapter-vercel": "^6.3.3",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/prismjs": "^1.26.6",
        "@vite-pwa/sveltekit": "^1.1.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "chart.js": "^4.5.1",
        "marked": "^18.0.9",
        "prismjs": "^1.30.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "workerd"
        ]
    }
}
