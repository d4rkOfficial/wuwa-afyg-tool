{
    "name": "wuwa-afyg-tool",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-mdi-icons.mjs",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "lint:eslint": "eslint .",
        "format": "prettier --write .",
        "test": "node --import ./scripts/test/preload.mjs scripts/test/run-provider-tests.ts",
        "test:watch": "node --import ./scripts/test/preload.mjs --watch scripts/test/run-provider-tests.ts",
        "download-icons": "node scripts/download-static-icons.mjs",
        "generate-icons": "node scripts/generate-icons.mjs",
        "collect-icons": "node scripts/collect-mdi-icons.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/svelte": "^5.2.2",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/adapter-vercel": "^6.3.3",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^26.2.0",
        "@vite-pwa/sveltekit": "^1.1.0",
        "eslint": "^10.8.1",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.11.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "chart.js": "^4.5.1",
        "marked": "^18.0.9"
    }
}
